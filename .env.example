# Google Gemini API key (server-side only; set it in the Vercel dashboard for deployments)
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite)
GEMINI_MODEL=
# Optional comma-separated fallbacks tried when a model is rate-limited/overloaded
# (default: gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite)
GEMINI_FALLBACK_MODELS=
